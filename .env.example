# Optional: GitHub fine-grained token used to fetch public programs for the
# /programs page with a higher rate limit. If unset, unauthenticated requests
# are used.
GITHUB_TOKEN="github_pat_xxx"

# Set automatically by next.config.ts; only override to pin the deployed commit.
NEXT_PUBLIC_COMMIT_SHA=""

# Newsletter signup (Brevo free plan). Set these server-side only.
BREVO_API_KEY=""
BREVO_LIST_ID=""
BREVO_DOI_TEMPLATE_ID=""
BREVO_CONFIRMATION_URL="https://openlake.in/newsletterpage?confirmed=1"
